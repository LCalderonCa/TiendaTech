@if (Oferta is not null)
{
    <div class="tt-precio">
        <span class="tt-precio-actual @(Grande ? "fs-3" : "")">@Formato.Soles(Oferta)</span>
        <span class="badge bg-danger ms-1">-@Formato.PorcentajeDescuento(Lista, Oferta)%</span>
        <div class="tt-precio-antes">Antes @Formato.Soles(Lista)</div>
    </div>
}
else
{
    <div class="tt-precio">
        <span class="tt-precio-actual @(Grande ? "fs-3" : "")">@Formato.Soles(Lista)</span>
    </div>
}

@code {
    [Parameter] public decimal Lista { get; set; }
    [Parameter] public decimal? Oferta { get; set; }
    [Parameter] public bool Grande { get; set; }
}
