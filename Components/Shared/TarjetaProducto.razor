<a class="card tt-card h-100 text-decoration-none" href="@($"/producto/{Producto.Slug}")">
    <div class="tt-card-img">
        <ImagenProducto Url="@Producto.Imagen" Alt="@Producto.Nombre" />
        @if (Producto.PrecioOferta is not null)
        {
            <span class="badge bg-danger tt-card-oferta">Oferta</span>
        }
    </div>
    <div class="card-body d-flex flex-column">
        <small class="text-uppercase text-muted fw-semibold">@Producto.Marca</small>
        <div class="tt-card-nombre">@Producto.Nombre</div>
        <Estrellas Valor="Producto.Rating" Cantidad="Producto.Resenas" />
        <div class="mt-auto pt-2">
            <Precio Lista="Producto.PrecioLista" Oferta="Producto.PrecioOferta" />
        </div>
    </div>
</a>

@code {
    [Parameter, EditorRequired] public ProductoCard Producto { get; set; } = default!;
}
