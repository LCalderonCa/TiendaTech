<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="icon" type="image/svg+xml" href="favicon.svg" />
    <ImportMap />
    <HeadOutlet @rendermode="Interactivo" />
</head>

<body>
    <Routes @rendermode="Interactivo" />
    <script src="_framework/blazor.web.js"></script>
</body>

</html>

@code {
    // Sin prerenderizado: la sesion se lee del localStorage del navegador antes de mostrar las paginas.
    private static readonly IComponentRenderMode Interactivo = new InteractiveServerRenderMode(prerender: false);
}
